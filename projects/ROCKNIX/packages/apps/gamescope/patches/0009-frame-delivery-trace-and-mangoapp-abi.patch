From: Orbital maintainers
Subject: [PATCH] Trace frame readiness and Wayland feedback; match MangoApp v1

Opt-in markers reuse GPUVis/ftrace's bounded ring buffer. A feedback ID joins
submit to presented/discarded; base_commit joins submit to app-ready. The host
presentation clock is recorded explicitly, not assumed to be the app clock.
The pinned MangoApp v1 receiver has visible timing before application timing.

diff --git a/src/commit.cpp b/src/commit.cpp
--- a/src/commit.cpp
+++ b/src/commit.cpp
@@ -3,6 +3,10 @@
 #include "steamcompmgr.hpp"
 #include "commit.h"
 
+#include "convar.h"
+gamescope::ConVar<bool> cv_orbital_frame_trace(
+    "orbital_frame_trace", false, "Opt-in frame delivery markers in the bounded ftrace buffer." );
+
 #include "gpuvis_trace_utils.h"
 
 extern gamescope::CAsyncWaiter<gamescope::Rc<commit_t>> g_ImageWaiter;
@@ -68,6 +72,10 @@ void commit_t::Signal()
     uint64_t now = get_time_in_nanos();
     present_time = now;
 
+    if ( cv_orbital_frame_trace )
+        gpuvis_trace_printf( "orbital_frame stage=ready pid=%u commit=%llu mono_ns=%llu desired_ns=%llu",
+            (unsigned)getpid(), (unsigned long long)commitID, (unsigned long long)now,
+            (unsigned long long)desired_present_time );
     uint64_t frametime;
     if ( m_bMangoNudge )
     {
diff --git a/src/mangoapp.cpp b/src/mangoapp.cpp
--- a/src/mangoapp.cpp
+++ b/src/mangoapp.cpp
@@ -21,10 +21,10 @@ struct mangoapp_msg_v1 {
     struct mangoapp_msg_header hdr;
 
     uint32_t pid;
-    uint64_t app_frametime_ns;
+    uint64_t visible_frametime_ns;
     uint8_t fsrUpscale;
     uint8_t fsrSharpness;
-    uint64_t visible_frametime_ns;
+    uint64_t app_frametime_ns;
     uint64_t latency_ns;
     uint32_t outputWidth;
     uint32_t outputHeight;
diff --git a/src/Backends/WaylandBackend.cpp b/src/Backends/WaylandBackend.cpp
